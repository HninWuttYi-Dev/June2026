<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - June2026.RealTimeNotiApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/June2026.RealTimeNotiApp.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home"
                   asp-action="Index">June2026.RealTimeNotiApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                               asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Product"
                               asp-action="Index">Product</a>
                        </li>
                        <li>
                            <!-- 1. Added ID to button and the badge span inside it -->
                            <button type="button" class="btn btn-primary position-relative" id="inboxBtn">
                                Inbox
                                <span id="notiCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                    0
                                </span>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - June2026.RealTimeNotiApp - <a asp-area="" asp-controller="Home"
                                                        asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    
    <script>

        let notificationCount = parseInt(localStorage.getItem("notiCount") || "0");
        const badge = document.getElementById("notiCount");
        const inboxBtn = document.getElementById("inboxBtn");

        // 2. Function to update UI and save to localStorage
        function updateBadge() {
            if (notificationCount > 0) {
                badge.innerText = notificationCount;
                badge.classList.remove("d-none"); 
            } else {
                badge.classList.add("d-none");   
            }
            localStorage.setItem("notiCount", notificationCount); // Save to browser memory
        }

        updateBadge();

        var connection = new signalR.HubConnectionBuilder().withUrl("/notiHub").build();

        connection.on("NewProductAdded", function (data) {
            console.log("Product event:", data);
            
            // Increment count and update UI
            notificationCount++;
            updateBadge();
        });

        connection.start().then(function () {
            if (inboxBtn) {
                inboxBtn.addEventListener("click", function() {
                    notificationCount = 0;
                    updateBadge();
                    alert("Inbox opened. Notifications cleared.");
                });
            }
        }).catch(function (err) {
            return console.error(err.toString());
        });
    </script>
    @await RenderSectionAsync("scripts", required: false)
</body>

</html>