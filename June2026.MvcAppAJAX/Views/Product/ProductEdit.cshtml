@{
    ViewData["Title"] = "Product Edit";
    int productId = 0;
    if (ViewData["Id"] != null)
    {
        productId = Convert.ToInt32(ViewData["Id"]);
    }
    string productName = string.Empty;
    if (ViewData["Name"] != null)
    {
        productName = Convert.ToString(ViewData["Name"]);
    }
    float price = 0f;
    if (ViewData["Price"] != null)
    {
        price = Convert.ToSingle(ViewData["Price"]);
    }
    int quantity = 0;
    if (ViewData["Quantity"] != null)
    {
        quantity = Convert.ToInt32(ViewData["Quantity"]);
    }
}

<div class="mb-3">
    <label for="productName" class="form-label">Product Name</label>
    <input type="text" class="form-control" id="productName" value="@productName" placeholder="Coffee">
</div>

<div class="mb-3">
    <label for="price" class="form-label">Price</label>
    <input type="number" class="form-control" id="price" value="@price" step="0.01" min="0.01">
</div>

<div class="mb-3">
    <label for="quantity" class="form-label">Quantity</label>
    <input type="number" class="form-control" id="quantity" value="@quantity" min="0">
</div>

<button type="button" class="btn btn-primary" id="btnSave">Update</button>
<a href="/Product" class="btn btn-outline-secondary">Cancel</a>

@section scripts {
    <script>
        $('#btnSave').on('click', function () {
            const _requestModel = {
                Name: $('#productName').val(),
                Price: $('#price').val() ? parseFloat($('#price').val()) : null,
                Quantity: $('#quantity').val() ? parseInt($('#quantity').val()) : null
            }
         $.ajax({
            type: 'POST',
            url: '/Product/Update/@productId',
            data: {requestModel: _requestModel},
            success: function(response) {
                    alert(response.Message);
                    if (!response.isSuccess) {
                        return;
                    }
                    window.location.href = '/Product';
                },
                error: function(xhr) {
                    alert("Error: " + xhr.responseText);
                }
         });
        });
    </script>
}