@model ProductListResponseModel
@{
    int count = 0;
    ViewData["Title"] = "Products";
    List<Product> productCards = ViewData["ProductCards"]
                                  as List<Product>
                                 ?? new List<Product>();
    bool hasMessage = TempData["Message"] != null;
    bool isSuccess = false;
    if (ViewData["isSuccess"] != null)
    {
        isSuccess = Convert.ToBoolean(ViewData["isSuccess"]);
    }
    string message = string.Empty;
    if (ViewData["Message"] != null)
    {
        message = Convert.ToString(ViewData["Message"]);
    }
}
<h1>Products</h1>
<a href="/Product/Create" class="btn btn-primary mb-3">Add Product</a>
@if (hasMessage)
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger")" role="alert">
        @message
    </div>
}
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Action</th>
            <th>No. </th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @if (Model?.Products == null || Model.Products.Count == 0)
        {
            <tr>
                <td colspan="6">No products found.</td>
            </tr>
        }
        else
        {
            foreach (Product item in Model.Products)
            {
                <tr>
                    <td>
                        <a href="/Product/Edit/@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteProduct(@item.Id)">Delete</button>
                    </td>
                    <td>@(++count)</td>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        }
    </tbody>
</table>
