@{
    ViewData["Title"] = "User List";
}
<h1>User List</h1>
<a href="/User/Create" class="btn btn-primary">Add User</a>
<table class="table table-responsive">
    <thead>
        <tr>
            <th>Action</th>
            <th>No.</th>
            <th>UserId</th>
            <th>Username</th>
        </tr>
    </thead>
    <tbody id="userTableBody">

    </tbody>
</table>
@section scripts {
    <script>
        loadData();
        function loadData() {
            $.ajax({
                type: "GET",
                url: 'User/UserList',
                success: function (data) {
                    console.log({ data });
                    for (let i = 0; i < data.Users.length; i++) {
                        let item = data.Users[i];
                        let row = `
                             <tr>
                                <td>
                                    <a href="/User/Edit/${item.UserId}" class="btn btn-sm btn-outline-warning">Edit</a>
                                    <button type="button" onclick="deleteUser('${item.UserId}')" class="btn btn-sm btn-outline-danger">Delete</button>
                                </td>
                                <td>${i + 1}</td>
                                <td>${item.UserId}</td>
                                <td>${item.Username}</td>
                         </tr>
                            `
                        $('#userTableBody').append(row);
                    }
                },
                error: function (xhr, status, error) {
                    alert("Error: " + xhr.responseText);
                }
            });

        }
        function deleteUser(id) {
            const confirmResult = confirm("Are you sure to delete?")
            if (!confirmResult) return;
            const _requestModel = { UserId: id };
            $.ajax({
                type: 'POST',
                url: "/User/Delete",
                data: { requestModel: _requestModel },
                success: function (response) {
                    console.log(response);
                    alert(response.Message);
                    if (!response.isSuccess) return;
                    window.location.reload();
                },
                error: function (xhr, status, error) {
                    alert("Error: " + xhr.responseText);
                }
            })
        }
    </script>
}

   